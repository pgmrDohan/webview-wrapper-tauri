{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "App Configuration",
  "description": "Application metadata and settings for the WebView wrapper",
  "type": "object",
  "required": ["productName", "identifier", "version", "websiteUrl"],
  "properties": {
    "productName": {
      "type": "string",
      "minLength": 1,
      "description": "Display name of the application"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9]*)+$",
      "description": "Reverse-domain app identifier (e.g. com.example.myapp)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g. 1.0.0)"
    },
    "websiteUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "URL of the website to wrap"
    },
    "apiUrl": {
      "type": "string",
      "description": "API base URL for CSP connect-src directive"
    },
    "userAgent": {
      "type": "string",
      "description": "Custom user agent string (empty for default)"
    },
    "backgroundColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "Background color in hex format (e.g. #ffffff)"
    },
    "splashBackgroundColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "Splash screen background color (hex)"
    }
  },
  "additionalProperties": false
}
