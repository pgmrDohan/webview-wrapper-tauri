{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "webview-wrapper-tauri",
  "version": "0.1.0",
  "identifier": "com.example",
  "build": {
    "devUrl": "https://example.com",
    "frontendDist": "https://example.com"
  },
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "center": true,
        "fullscreen": true,
        "url": "https://example.com",
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' https: data: blob:; connect-src 'self' https: wss:; font-src 'self' https: data:; media-src 'self' https: blob:",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
