{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My App",
  "version": "1.0.0",
  "identifier": "com.example.myapp",
  "build": {
    "devUrl": "https://example.com",
    "frontendDist": "https://example.com"
  },
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "center": true,
        "fullscreen": true,
        "resizable": false,
        "url": "https://example.com",
        "useHttpsScheme": true,
        "userAgent": "",
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$DOCUMENT/**", "$CACHE/**", "$TEMP/**"]
      },
      "csp": "default-src 'self' https://example.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://example.com; style-src 'self' 'unsafe-inline' https://example.com; img-src 'self' asset: https: data: blob:; connect-src 'self' https://example.com https://api.example.com https: wss:; font-src 'self' https://example.com https: data:; media-src 'self' https://example.com https: blob:",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "android": {
      "autoIncrementVersionCode": false
    },
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {},
    "fileAssociations": []
  }
}
