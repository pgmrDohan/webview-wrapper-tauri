{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{ app.productName }}",
  "version": "{{ app.version }}",
  "identifier": "{{ app.identifier }}",
  "build": {
    "devUrl": "{{ app.websiteUrl }}",
    "frontendDist": "{{ app.websiteUrl }}"
  },
  "plugins": {{ plugins_config | tojson(indent=2) }},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "center": true,
        "fullscreen": true,
        "resizable": false,
        "url": "{{ app.websiteUrl }}",
        "useHttpsScheme": true,
        "userAgent": "{{ app.userAgent }}",
        "backgroundColor": "{{ app.backgroundColor }}"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$DOCUMENT/**", "$CACHE/**", "$TEMP/**"]
      },
      "csp": "{{ csp }}",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "android": {
      "autoIncrementVersionCode": false
    },
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {},
    "fileAssociations": {{ file_associations | tojson(indent=2) }}
  }
}
